{
    "name": "dreamestate",
    "version": "1.0.0",
    "description": "dreamestate.com.au",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "build-remote": "vite build && vite build --ssr && node zip-build.js && node upload-build.js",
        "backend": "php artisan serve",
        "build-upload": "node upload-build.js",
        "prod": "npm run build",
        "clean-yarn": "rm -rf node_modules package-lock.json && yarn cache clean --force && yarn install && yarn build",
        "clean-dev": "rm -rf node_modules package-lock.json && npm cache clean --force && npm i && npm run dev",
        "clean-build": "rm -rf node_modules package-lock.json && npm cache clean --force && npm i && npm run build"
    },
